datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String? 
  completed   Boolean   @default(false)
  completedAt DateTime? // Timestamp cuando se completó la tarea
  // Use plain strings for priority and category to maximize connector compatibility
  priority    String    @default("medium")
  category    String    @default("other")
  dueDate     DateTime?
  deleted     Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([title])
  @@index([priority])
  @@index([category])
  @@index([completed])
  @@index([completedAt])
}
